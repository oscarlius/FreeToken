+@pytest.mark.parametrize("post_weights_free", [600, 1000, 1200])
+def test_model_load_memory_snapshot_before_cache_allocation(monkeypatch, post_weights_free):
+    import freetoken.engine.engine as module
+    import freetoken.gpu_select as gpu_select
+
+    monkeypatch.delenv("FT_DEV_ROUTE_TRACE", raising=False)
+    for name in ("set_tp_info", "set_quant_backend", "_ensure_expandable_segments",
+                 "_adjust_config", "set_global_ctx", "set_rope_device"):
+        monkeypatch.setattr(module, name, Mock())
+    monkeypatch.setattr(module, "_adjust_ftw_quant_backend", lambda path, backend: backend)
+    monkeypatch.setattr(module, "logger", Mock())
+    monkeypatch.setattr(module.QuantBackend, "parse", Mock(return_value=None))
+    monkeypatch.setattr(gpu_select, "bind_assigned_gpu", Mock(return_value=torch.device("cpu")))
+    monkeypatch.setattr(torch, "manual_seed", Mock())
+    monkeypatch.setattr(torch.cuda, "is_initialized", Mock(return_value=False))
+    monkeypatch.setattr(torch.cuda, "Stream", Mock())
+    monkeypatch.setattr(torch.cuda, "set_stream", Mock())
+    monkeypatch.setattr(module, "Context", Mock())
+    monkeypatch.setattr(module, "resolve_pool_class", Mock())
+    monkeypatch.setattr(module, "create_model", Mock(return_value=SimpleNamespace()))
+    monkeypatch.setattr(module.Engine, "_init_communication", Mock())
+    monkeypatch.setattr(module.Engine, "_load_weights", Mock())
+    monkeypatch.setattr(module.Engine, "_sync_get_memory", Mock(side_effect=[
+        (1000, 1000), (post_weights_free, post_weights_free),
+    ]))
+    monkeypatch.setattr(module, "is_offload_moe_strategy", Mock(return_value=True))
+    allocate = Mock(side_effect=StopIteration("reached cache allocation"))
+    monkeypatch.setattr(module.Engine, "_init_offload_moe_cache", allocate)
+    config = SimpleNamespace(
+        tp_info=SimpleNamespace(rank=0, size=1), model_path="unused", quant_backend="auto",
+        dtype=torch.float16, model_config=SimpleNamespace(), page_size=64,
+        active_encoders=(), moe_strategy="offload",
+    )
+    engine = module.Engine.__new__(module.Engine)
+    if post_weights_free > 1000:
+        with pytest.raises(RuntimeError, match="GPU free memory increased during model loading"):
+            engine.__init__(config)
+        allocate.assert_not_called()
+    else:
+        with pytest.raises(StopIteration, match="reached cache allocation"):
+            engine.__init__(config)
+        allocate.assert_called_once_with(config)
+        assert engine._weights_bytes == 1000 - post_weights_free
+        assert engine._baseline_free == 1000
+        assert engine._post_weights_free == post_weights_free
+
+
