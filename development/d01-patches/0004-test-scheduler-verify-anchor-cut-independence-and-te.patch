@@ -0,0 +1,126 @@
+from __future__ import annotations
+
+import torch
+
+from freetoken.core import Context, SamplingParams, get_global_ctx, set_global_ctx
+from freetoken.scheduler.cache import CacheManager
+from freetoken.scheduler.decode import DecodeManager
+from freetoken.scheduler.prefill import PrefillManager
+from freetoken.scheduler.prefill_trace import (
+    SEG_REASON_ANCHOR_CAP,
+    SEG_REASON_CONTINUATION,
+    SEG_REASON_LAYER_MAJOR_WHOLE,
+    SEG_REASON_OTHER,
+    SEG_REASON_TOKEN_BUDGET,
+)
+from freetoken.scheduler.table import TableManager
+from freetoken.scheduler.utils import PendingReq
+
+
+def _manager(*, anchor_ids=frozenset(), anchor_cut=True, layer_major=False):
+    try:
+        get_global_ctx()
+    except AssertionError:
+        set_global_ctx(Context(page_size=1))
+    table = torch.zeros((8, 64), dtype=torch.int32)
+    cache = CacheManager(num_pages=64, page_size=1, page_table=table, type="radix")
+    return PrefillManager(
+        cache,
+        TableManager(max_running_reqs=7, page_table=table),
+        DecodeManager(page_size=1),
+        anchor_ids=anchor_ids,
+        prefill_anchor_cut=anchor_cut,
+        layer_major=layer_major,
+    )
+
+
+def _pending(uid, ids):
+    return PendingReq(uid, torch.tensor(ids, dtype=torch.int32), SamplingParams(max_tokens=1))
+
+
+def test_anchor_cut_switch_only_gates_prefill_scan():
+    anchored = list(range(12))
+    anchored[5] = 99
+    on = _manager(anchor_ids=frozenset({99}), anchor_cut=True)
+    on.pending_list = [_pending(1, anchored)]
+    on_batch = on.schedule_next_batch(12)
+    assert on_batch.reqs[0].extend_len == 5
+    assert on_batch.seg_reason == SEG_REASON_ANCHOR_CAP
+
+    off = _manager(anchor_ids=frozenset({99}), anchor_cut=False)
+    off.pending_list = [_pending(1, anchored)]
+    off_batch = off.schedule_next_batch(12)
+    assert off.anchor_ids == frozenset({99})
+    assert off_batch.reqs[0].extend_len == 12
+    assert off_batch.seg_reason == SEG_REASON_OTHER
+
+
+def test_anchor_mode_selects_first_or_last_without_switch_changes(monkeypatch):
+    ids = list(range(12))
+    ids[3] = 99
+    ids[8] = 99
+    for mode, expected in (("first", 3), ("last", 8)):
+        monkeypatch.setenv("FT_D3_ANCHOR_MODE", mode)
+        manager = _manager(anchor_ids=frozenset({99}))
+        manager.pending_list = [_pending(1, ids)]
+        batch = manager.schedule_next_batch(12)
+        assert batch.reqs[0].extend_len == expected
+        assert batch.seg_reason == SEG_REASON_ANCHOR_CAP
+
+
+def test_segment_reason_tracks_actual_final_cap():
+    token = _manager()
+    token.pending_list = [_pending(1, range(20))]
+    assert token.schedule_next_batch(8).seg_reason == SEG_REASON_TOKEN_BUDGET
+
+    layer_major = _manager(layer_major=True)
+    layer_major.pending_list = [_pending(1, range(20))]
+    assert layer_major.schedule_next_batch(8).seg_reason == SEG_REASON_LAYER_MAJOR_WHOLE
+
+    continuation = _manager()
+    continuation.pending_list = [_pending(1, range(12))]
+    first = continuation.schedule_next_batch(8)
+    for req in first.reqs:
+        continuation.cache_manager.allocate_paged([req])
+        req.complete_one()
+    second = continuation.schedule_next_batch(8)
+    assert second.seg_reason == SEG_REASON_CONTINUATION
+    assert second.seg_reqs == [{"rid": 1, "new_tokens": 4, "cached_tokens": 0}]
+
+
+def test_batch_reason_uses_documented_priority_and_schedule_snapshot():
+    ids = list(range(20))
+    ids[5] = 99
+    manager = _manager(anchor_ids=frozenset({99}))
+    manager.pending_list = [_pending(1, ids), _pending(2, range(20))]
+    batch = manager.schedule_next_batch(8)
+
+    assert batch.seg_reason == SEG_REASON_ANCHOR_CAP
+    assert [req.seg_reason for req in batch.reqs] == [
+        SEG_REASON_ANCHOR_CAP,
+        SEG_REASON_TOKEN_BUDGET,
+    ]
+    snapshot = [dict(item) for item in batch.seg_reqs]
+    assert sum(item["new_tokens"] for item in snapshot) == batch.log_new_tokens
+    assert sum(item["cached_tokens"] for item in snapshot) == batch.log_cached_tokens
+    for req in batch.reqs:
+        manager.cache_manager.allocate_paged([req])
+        req.complete_one()
+    assert batch.seg_reqs == snapshot
+
+
+def test_segment_metadata_uses_cache_hit_only_on_first_segment():
+    manager = _manager()
+    manager.pending_list = [_pending(1, range(8))]
+    first = manager.schedule_next_batch(8)
+    req = first.reqs[0]
+    manager.cache_manager.allocate_paged([req])
+    req.complete_one()
+    manager.cache_manager.cache_req(req, finished=True)
+    manager.table_manager.free(req.table_idx)
+
+    manager.pending_list = [_pending(2, range(12))]
+    hit = manager.schedule_next_batch(12)
+    assert hit.seg_reqs == [{"rid": 2, "new_tokens": 4, "cached_tokens": 8}]
+    assert hit.log_new_tokens == 4
+    assert hit.log_cached_tokens == 8
diff --git a/tests/scheduler/test_prefill_d0_metadata.py b/tests/scheduler/test_prefill_d0_metadata.py
new file mode 100644
index 0000000..8e9f748
--- /dev/null
+++ b/tests/scheduler/test_prefill_d0_metadata.py
@@ -0,0 +1,119 @@
+"""CPU-only contract tests for D0's delayed prefill telemetry flush."""
+
+from __future__ import annotations
+
+import json
+import threading
+from types import SimpleNamespace
+
+import torch
+
+from freetoken.moe import offload_cache
+from freetoken.moe.offload_cache import OffloadMoeCache
+
+
+def _cache(tmp_path, *, enabled: bool = True) -> OffloadMoeCache:
+    """Minimal cache shape: these tests exercise host-only telemetry bookkeeping."""
+    cache = OffloadMoeCache.__new__(OffloadMoeCache)
+    cache._d0_on = enabled
+    cache._d0_layers = []
+    cache._d0_chunk_idx = 0
+    cache._d0_h2d = 0
+    cache._d0_d2d = 0
+    cache._d0_t_begin = 0.0
+    cache._d0_prefill_path = str(tmp_path / "d0_prefill.jsonl")
+    cache._d0_decode_path = str(tmp_path / "d0_decode.json")
+    cache._d0_decode_finished = False
+    cache._d0_decode_lock = threading.RLock()
+    cache.decode_target = "gpu"
+    cache.device = torch.device("cpu")
+    cache.prefill_overlap = False
+    cache.anchor_snapshot_source = SimpleNamespace(anchor_snapshots_taken=0)
+    cache.decode_miss_stats = lambda: {"misses": 3}
+    cache.decode_miss_stats_per_layer = lambda: [{"layer": 0, "misses": 3}]
+    return cache
+
+
+def _complete_layer(cache: OffloadMoeCache, layer: int = 0) -> None:
+    cache._d0_layers.append(
+        {
+            "layer": layer,
+            "copy_start": None,
+            "copy_end": None,
+            "compute_start": None,
+            "compute_end": None,
+            "d2d_start": None,
+            "d2d_end": None,
+        }
+    )
+
+
+class _Logger:
+    def __init__(self) -> None:
+        self.messages: list[str] = []
+
+    def info(self, message, *args) -> None:
+        self.messages.append(message % args)
+
+
+def test_delayed_flush_keeps_segment_metadata_aligned_and_immutable(tmp_path, monkeypatch):
+    logger = _Logger()
+    monkeypatch.setattr(offload_cache, "logger", logger)
+    cache = _cache(tmp_path)
+    first = SimpleNamespace(
+        seg_reason="anchor_cap",
+        seg_reqs=[{"rid": 7, "new_tokens": 12, "cached_tokens": 4}],
+    )
+    second = SimpleNamespace(
+        seg_reason="token_budget",
+        seg_reqs=[{"rid": 9, "new_tokens": 8, "cached_tokens": 0}],
+    )
+
+    cache.begin_prefill(first)
+    first.seg_reqs[0]["new_tokens"] = 999  # scheduler may mutate after admission
+    _complete_layer(cache)
+    cache.begin_prefill(second)              # writes the preceding segment
+    _complete_layer(cache)
+    cache.begin_prefill(SimpleNamespace(seg_reason="other", seg_reqs=[]))
+
+    records = [json.loads(line) for line in (tmp_path / "d0_prefill.jsonl").read_text().splitlines()]
+    assert [(r["chunk"], r["seg_reason"], r["reqs"]) for r in records] == [
+        (0, "anchor_cap", [{"rid": 7, "new_tokens": 12, "cached_tokens": 4}]),
+        (1, "token_budget", [{"rid": 9, "new_tokens": 8, "cached_tokens": 0}]),
+    ]
+    assert "D0 seg: idx=0 reason=anchor_cap reqs=7:12/4" in logger.messages
+    assert "D0 seg: idx=1 reason=token_budget reqs=9:8/0" in logger.messages
+
+
+def test_d0_off_writes_no_prefill_or_decode_telemetry(tmp_path, monkeypatch):
+    logger = _Logger()
+    monkeypatch.setattr(offload_cache, "logger", logger)
+    cache = _cache(tmp_path, enabled=False)
+    cache.begin_prefill(SimpleNamespace(seg_reason="anchor_cap", seg_reqs=[]))
+    _complete_layer(cache)
+    cache._d0_flush_chunk()
+    cache._d0_finish_decode()
+
+    assert not (tmp_path / "d0_prefill.jsonl").exists()
+    assert not (tmp_path / "d0_decode.json").exists()
+    assert not any(message.startswith("D0 seg:") for message in logger.messages)
+
+
+def test_final_decode_snapshot_includes_successful_anchor_count_once(tmp_path, monkeypatch):
+    logger = _Logger()
+    monkeypatch.setattr(offload_cache, "logger", logger)
+    cache = _cache(tmp_path)
+    cache.anchor_snapshot_source.anchor_snapshots_taken = 2
+
+    cache._d0_write_decode()
+    periodic = json.loads((tmp_path / "d0_decode.json").read_text())
+    assert periodic["anchor_snapshots_taken"] == 2
+
+    cache._d0_finish_decode()
+    cache.anchor_snapshot_source.anchor_snapshots_taken = 3
+    cache._d0_finish_decode()
+
+    snapshot = json.loads((tmp_path / "d0_decode.json").read_text())
+    assert snapshot["anchor_snapshots_taken"] == 2
+    assert snapshot["misses"] == 3
+    assert logger.messages.count("D0 anchor_snapshots_taken=2") == 1
