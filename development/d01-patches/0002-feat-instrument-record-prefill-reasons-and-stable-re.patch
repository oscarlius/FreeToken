From: shangfeng-liu <liusf1987@gmail.com>
Date: Sat, 3 Oct 2026 23:46:35 +0800
Subject: [PATCH 2/4] feat(instrument): record prefill reasons and stable
 request metadata

---
 python/freetoken/core.py                    |  7 ++++
 python/freetoken/engine/engine.py           |  2 +-
 python/freetoken/layers/moe.py              |  2 +-
 python/freetoken/moe/offload_cache.py       | 32 +++++++++++++--
 python/freetoken/scheduler/prefill.py       | 43 +++++++++++++++++++--
 python/freetoken/scheduler/prefill_trace.py | 16 ++++++++
 6 files changed, 94 insertions(+), 8 deletions(-)
 create mode 100644 python/freetoken/scheduler/prefill_trace.py

diff --git a/python/freetoken/core.py b/python/freetoken/core.py
index 15aab95..349ba59 100644
--- a/python/freetoken/core.py
+++ b/python/freetoken/core.py
@@ -70,6 +70,8 @@ class Req:
     # handler must not free resources under an in-flight forward; it sets this flag and
     # _process_last_data frees the request when the batch drains (after copy_done.synchronize).
     aborted: bool = False
+    # Final cap selected for this scheduled prefill segment.
+    seg_reason: str = "other"
 
     def __post_init__(self) -> None:
         assert self.input_ids.is_cpu
@@ -155,6 +157,11 @@ class Batch:
     # PrefillManager; 0 on decode batches.
     log_new_tokens: int = field(default=0, init=False)
     log_cached_tokens: int = field(default=0, init=False)
+    # Schedule-time prefill metadata. ``seg_reqs`` snapshots each request before
+    # complete_one() advances its cached length; continuation cached_tokens is 0
+    # because its consumed prefix is not a new prefix-cache hit.
+    seg_reason: str = field(default="other", init=False)
+    seg_reqs: list[dict[str, int]] = field(default_factory=list, init=False)
     # (uid, complete prompt length, prefix-cache hit) for requests entering their first
     # prepared prefill batch. The scheduler turns these into PromptAdmittedMsg only AFTER
     # _prepare_batch succeeds. Continuation chunks leave this empty, so accounting is
diff --git a/python/freetoken/engine/engine.py b/python/freetoken/engine/engine.py
index d78d116..1338e40 100644
--- a/python/freetoken/engine/engine.py
+++ b/python/freetoken/engine/engine.py
@@ -1125,7 +1125,7 @@ class Engine:
         cache = self.moe_offload_cache
         chunks = self._build_layer_major_chunks(batch)
         if cache is not None:
-            cache.begin_prefill()
+            cache.begin_prefill(batch)
         return self.model.forward_layer_major(chunks)
 
     @torch.inference_mode()
diff --git a/python/freetoken/layers/moe.py b/python/freetoken/layers/moe.py
index eaf2b9e..5353c38 100644
--- a/python/freetoken/layers/moe.py
+++ b/python/freetoken/layers/moe.py
@@ -391,7 +391,7 @@ class OffloadMoELayer(MoELayer):
         """
         batch = get_global_ctx().batch  # D1: layer-major passes per-chunk sub-batches here
         if self.layer_id == 0 and not getattr(batch, "skip_begin_prefill", False):
-            cache.begin_prefill()
+            cache.begin_prefill(batch)
         cache.prefetch_prefill_layer(self.layer_id)
         cache.prefetch_prefill_layer(self.layer_id + 1)
         return cache.wait_prefill_layer(self.layer_id)
diff --git a/python/freetoken/moe/offload_cache.py b/python/freetoken/moe/offload_cache.py
index 3f1fd37..05e7870 100644
--- a/python/freetoken/moe/offload_cache.py
+++ b/python/freetoken/moe/offload_cache.py
@@ -355,9 +355,21 @@ class OffloadMoeCache:
             threading.Thread(target=_d0_dump_decode, daemon=True).start()
             logger.info("D0 instrumentation enabled (prefill -> %s, decode -> %s)", *(_dev_d0_paths()))
 
+    def _d0_set_segment(self, batch) -> None:
+        """Copy schedule-frozen metadata before the next scheduler mutation can move it."""
+        import copy
+
+        self._d0_segment = {
+            "seg_reason": getattr(batch, "seg_reason", "other"),
+            "reqs": copy.deepcopy(getattr(batch, "seg_reqs", [])),
+        }
+
+
     def _d0_flush_chunk(self) -> None:
         """Flush one prefill chunk's byte/timing record (called at the next chunk's
         begin_prefill, i.e. after all of the previous chunk's layer records landed)."""
+        if not getattr(self, "_d0_on", False):
+            return
         if not self._d0_layers:
             return
         import json as _json
@@ -393,6 +405,7 @@ class OffloadMoeCache:
             "d2d_gib": tot_d2d_gib,
             "layers": layers,
         }
+        rec.update(getattr(self, "_d0_segment", {"seg_reason": "other", "reqs": []}))
         try:
             with open(self._d0_prefill_path, "a") as f:
                 f.write(_json.dumps(rec) + chr(10))
@@ -402,6 +415,15 @@ class OffloadMoeCache:
             "D0 prefill chunk %d: wall %.3fs, H2D %.2f GiB, D2D %.3f GiB, layers %d",
             self._d0_chunk_idx, wall, tot_h2d_gib, tot_d2d_gib, len(layers),
         )
+        reqs = rec["reqs"]
+        req_summary = ",".join(
+            f"{req.get('rid')}:{req.get('new_tokens')}/{req.get('cached_tokens')}"
+            for req in reqs
+        )
+        logger.info(
+            "D0 seg: idx=%d reason=%s reqs=%s",
+            self._d0_chunk_idx, rec["seg_reason"], req_summary,
+        )
         self._d0_chunk_idx += 1
         self._d0_h2d = 0
         self._d0_d2d = 0
@@ -775,11 +797,15 @@ class OffloadMoeCache:
         # ensure_experts evicts them first.
         self.usage[slot_start:slot_end].zero_()
 
-    def begin_prefill(self) -> None:
+    def begin_prefill(self, batch=None) -> None:
+        if getattr(self, "_d0_on", False):
+            # This flush belongs to the previous chunk. Copy the incoming metadata only
+            # afterwards so the just-written record cannot be attributed to the next chunk.
+            self._d0_flush_chunk()
+            if batch is not None:
+                self._d0_set_segment(batch)
         if not self.prefill_overlap:
             return
-        if self._d0_on:
-            self._d0_flush_chunk()
         self._prefill_buffer_layer = [None, None]
         self._prefill_buffer_released = [True, True]
         if self.prefill_copy_stream is not None:
diff --git a/python/freetoken/scheduler/prefill.py b/python/freetoken/scheduler/prefill.py
